# --- Секреты / окружение ---
.env
.env.local
.env.*.local

# --- Скомпилированные бинарники ---
# Бинарь модуля (go build без -o кладёт его сюда)
/vk-parser
# Сборка точки входа кладётся в bin/ (go build -o bin/parser ./app)
/bin/
# Windows / прочие платформы
*.exe
*.exe~
*.dll
*.so
*.dylib

# --- Тесты и покрытие ---
*.test
*.out
coverage.*

# --- Сгенерированные артефакты парсера (не исходники) ---
/elkidom_data.json
/*_data.json

# --- Конфиги реальных объектов (чужой контент) держим локально ---
# В репо только пример формата data/example.json.
/data/*.json
!/data/example.json

# --- Страницы Авито, сохранённые из браузера (--provider=avito) ---
# Каждая весит около мегабайта и содержит чужой контент: описание объявления,
# имя и аватар продавца, служебные хэши площадки. Репозиторий публичный.
# В git лежат только компактные обезличенные вырезки из них —
# providers/avito/testdata/*.html (генератор — make_fixture.py рядом).
/pages/
/avito-pages/

# --- Go workspace ---
go.work
go.work.sum

# --- Зависимости (если используется vendoring) ---
/vendor/

# --- IDE / ОС ---
.DS_Store
.idea/
.vscode/

# Пакетный вывод провайдеров (регенерируется)
generated/
.gstack/
